<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/field_focus</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/field_border</item>
        <item name="android:colorControlActivated">@color/field_focus</item>
        <item name="android:colorButtonNormal">@color/button_background</item>
        <item name="android:editTextStyle">@style/AppField</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/text_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppField" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:background">@drawable/field_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColorHighlight">@color/button_pressed</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="AppFieldLabel" parent="android:style/Widget.Material.Light.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="AppButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
