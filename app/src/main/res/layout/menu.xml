<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:orientation="vertical" android:padding="24dp" android:background="@color/screen_background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOTAS DOCENTE" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Panel principal" android:textSize="28sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Universidades en el dispositivo · Usuarios en el servidor" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/bienvenida" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="22sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
            <Button style="@style/AppButton" android:id="@+id/universidades" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Administrar universidades"/>
            <Button style="@style/AppButton" android:id="@+id/usuarios" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usuarios y mi perfil"/>
            <Button style="@style/AppButton" android:id="@+id/salir" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cerrar sesión"/>
            <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
            <TextView android:id="@+id/estado" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
